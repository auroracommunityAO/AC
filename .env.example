# Token usado para entrar na área privada /gestão.
GESTAO_TOKEN=replace-with-a-long-random-token

# Token GitHub de granularidade fina. Nunca o coloque no frontend.
# Repositório seleccionado: auroracommunityAO/AC
GITHUB_TOKEN=replace-with-a-fine-grained-github-token
GITHUB_OWNER=auroracommunityAO
GITHUB_REPO=AC
GITHUB_BRANCH=main

# Porta usada pelo servidor independente.
PORT=4173
